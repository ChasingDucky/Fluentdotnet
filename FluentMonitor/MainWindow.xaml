<ui:FluentWindow x:Class="FluentMonitor.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
                 mc:Ignorable="d"
                 Title="系统性能监测器 - Fluent Monitor"
                 Height="800"
                 Width="1200"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="系统性能监测器"
                     Icon="pack://application:,,,/Assets/icon.png"
                     ShowMaximize="True"
                     ShowMinimize="True"/>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="系统性能监测器"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="实时监控您的 Windows 系统性能和硬件状态"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Quick Stats Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU Card -->
                    <ui:Card Grid.Column="0" Margin="0,0,10,0" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="Memories24" FontSize="24" Margin="0,0,10,0"/>
                                <TextBlock Text="CPU" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="CpuUsageText"
                                       Text="0%"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="CpuNameText"
                                       Text="加载中..."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Memory Card -->
                    <ui:Card Grid.Column="1" Margin="0,0,10,0" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="Server24" FontSize="24" Margin="0,0,10,0"/>
                                <TextBlock Text="内存" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MemoryUsageText"
                                       Text="0%"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="MemoryDetailsText"
                                       Text="0 GB / 0 GB"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Disk Card -->
                    <ui:Card Grid.Column="2" Margin="0,0,10,0" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="SaveMultiple24" FontSize="24" Margin="0,0,10,0"/>
                                <TextBlock Text="磁盘" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="DiskUsageText"
                                       Text="0%"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="DiskDetailsText"
                                       Text="0 MB/s"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Network Card -->
                    <ui:Card Grid.Column="3" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="Wifi124" FontSize="24" Margin="0,0,10,0"/>
                                <TextBlock Text="网络" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="NetworkSpeedText"
                                       Text="0 KB/s"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="NetworkDetailsText"
                                       Text="↓ 0 KB/s ↑ 0 KB/s"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <!-- Charts Section -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU Chart -->
                    <ui:Card Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="CPU 使用率历史"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,15"/>
                            <lvc:CartesianChart Grid.Row="1"
                                                x:Name="CpuChart"
                                                LegendPosition="Hidden"/>
                        </Grid>
                    </ui:Card>

                    <!-- Memory Chart -->
                    <ui:Card Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="内存使用率历史"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,15"/>
                            <lvc:CartesianChart Grid.Row="1"
                                                x:Name="MemoryChart"
                                                LegendPosition="Hidden"/>
                        </Grid>
                    </ui:Card>

                    <!-- Disk Chart -->
                    <ui:Card Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="磁盘活动"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,15"/>
                            <lvc:CartesianChart Grid.Row="1"
                                                x:Name="DiskChart"
                                                LegendPosition="Bottom"/>
                        </Grid>
                    </ui:Card>

                    <!-- Network Chart -->
                    <ui:Card Grid.Row="1" Grid.Column="1" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="网络活动"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,15"/>
                            <lvc:CartesianChart Grid.Row="1"
                                                x:Name="NetworkChart"
                                                LegendPosition="Bottom"/>
                        </Grid>
                    </ui:Card>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>

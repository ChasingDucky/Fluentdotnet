<Window x:Class="FluentMonitor.DesktopWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Fluent Monitor Widget"
        Height="320"
        Width="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Widget_MouseLeftButtonDown"
        MouseRightButtonDown="Widget_MouseRightButtonDown">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Background="#CC1A1A1A"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="15">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="20" ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="系统监控"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="UpdateTimeText"
                               Text="实时更新"
                               FontSize="9"
                               Foreground="#A0A0A0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="CloseButton"
                        Content="✕"
                        Width="24"
                        Height="24"
                        FontSize="14"
                        Background="Transparent"
                        Foreground="#A0A0A0"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#40FF0000"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Performance Data -->
            <StackPanel Grid.Row="1">
                <!-- CPU -->
                <Border Background="#20FFFFFF"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#300078D4"
                                Margin="0,0,12,0">
                            <TextBlock Text="CPU"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#0078D4"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CPU 使用率" Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="WidgetCpuText"
                                       Text="0%"
                                       Style="{StaticResource ValueStyle}"
                                       Foreground="#0078D4"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Memory -->
                <Border Background="#20FFFFFF"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#3010893E"
                                Margin="0,0,12,0">
                            <TextBlock Text="RAM"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#10893E"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="内存使用率" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="WidgetMemoryText"
                                           Text="0%"
                                           Style="{StaticResource ValueStyle}"
                                           Foreground="#10893E"/>
                                <TextBlock x:Name="WidgetMemoryDetailText"
                                           Text="0/0GB"
                                           FontSize="10"
                                           Foreground="#A0A0A0"
                                           VerticalAlignment="Bottom"
                                           Margin="8,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Disk -->
                <Border Background="#20FFFFFF"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#30FF8C00"
                                Margin="0,0,12,0">
                            <TextBlock Text="DISK"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#FF8C00"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="磁盘活动" Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="WidgetDiskText"
                                       Text="0 MB/s"
                                       Style="{StaticResource ValueStyle}"
                                       Foreground="#FF8C00"
                                       FontSize="16"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Network -->
                <Border Background="#20FFFFFF"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#30E81123"
                                Margin="0,0,12,0">
                            <TextBlock Text="NET"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#E81123"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="网络速度" Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="WidgetNetworkText"
                                       Text="0 KB/s"
                                       Style="{StaticResource ValueStyle}"
                                       Foreground="#E81123"
                                       FontSize="16"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>

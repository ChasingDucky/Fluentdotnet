<ui:FluentWindow x:Class="FluentMonitor.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
                 xmlns:tb="http://www.hardcodet.net/taskbar"
                 mc:Ignorable="d"
                 Title="系统性能监测器 - Fluent Monitor"
                 Height="900"
                 Width="1400"
                 MinHeight="600"
                 MinWidth="800"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 StateChanged="Window_StateChanged">

    <Grid>
        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/icon.ico"
                        ToolTipText="Fluent Monitor - 系统性能监测器"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开" Click="ShowWindow_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Window24"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="退出" Click="Exit_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="系统性能监测器 - Fluent Monitor"
                     ShowMaximize="True"
                     ShowMinimize="True"/>

        <!-- Main Content with Tabs -->
        <Grid Grid.Row="1" Margin="10">
            <TabControl Style="{DynamicResource {x:Type TabControl}}">
                <!-- Performance Tab -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ChartMultiple24" Margin="0,0,8,0"/>
                            <TextBlock Text="性能概览" FontSize="14"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- System Info Header -->
                            <ui:Card Grid.Row="0" Margin="0,0,0,15" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="处理器" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="SystemCpuName" Text="加载中..." FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="系统内存" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="SystemTotalMemory" Text="加载中..." FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="系统运行时间" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="SystemUptime" Text="加载中..." FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="进程/线程/句柄" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="SystemProcessInfo" Text="0 / 0 / 0" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <!-- Quick Stats Cards -->
                            <Grid Grid.Row="1" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CPU Card -->
                                <ui:Card Grid.Column="0" Margin="0,0,7.5,0" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                            <ui:SymbolIcon Symbol="Memories24" FontSize="20" Margin="0,0,8,0"/>
                                            <TextBlock Text="CPU" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="CpuUsageText"
                                                       Text="0%"
                                                       FontSize="42"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2">
                                            <TextBlock x:Name="CpuSpeedText"
                                                       Text="速度: 0.0 GHz"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,0,0,2"/>
                                            <TextBlock x:Name="CpuCoresText"
                                                       Text="核心: 0 / 逻辑: 0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>

                                <!-- Memory Card -->
                                <ui:Card Grid.Column="1" Margin="7.5,0,7.5,0" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                            <ui:SymbolIcon Symbol="Server24" FontSize="20" Margin="0,0,8,0"/>
                                            <TextBlock Text="内存" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="MemoryUsageText"
                                                       Text="0%"
                                                       FontSize="42"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2">
                                            <TextBlock x:Name="MemoryDetailsText"
                                                       Text="已用: 0 GB / 0 GB"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,0,0,2"/>
                                            <TextBlock x:Name="MemoryCommittedText"
                                                       Text="已提交: 0 GB"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,0,0,2"/>
                                            <TextBlock x:Name="MemoryCachedText"
                                                       Text="已缓存: 0 GB"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>

                                <!-- Disk Card -->
                                <ui:Card Grid.Column="2" Margin="7.5,0,7.5,0" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                            <ui:SymbolIcon Symbol="SaveMultiple24" FontSize="20" Margin="0,0,8,0"/>
                                            <TextBlock Text="磁盘" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="DiskActiveTimeText"
                                                       Text="0%"
                                                       FontSize="42"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2">
                                            <TextBlock x:Name="DiskReadText"
                                                       Text="读取: 0 MB/s"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,0,0,2"/>
                                            <TextBlock x:Name="DiskWriteText"
                                                       Text="写入: 0 MB/s"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>

                                <!-- Network Card -->
                                <ui:Card Grid.Column="3" Margin="7.5,0,0,0" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                            <ui:SymbolIcon Symbol="Wifi124" FontSize="20" Margin="0,0,8,0"/>
                                            <TextBlock Text="网络" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="NetworkTotalText"
                                                       Text="0 KB/s"
                                                       FontSize="36"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2">
                                            <TextBlock x:Name="NetworkSentText"
                                                       Text="↑ 发送: 0 KB/s"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,0,0,2"/>
                                            <TextBlock x:Name="NetworkReceivedText"
                                                       Text="↓ 接收: 0 KB/s"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </Grid>

                            <!-- Charts Section -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CPU Chart -->
                                <ui:Card Grid.Row="0" Grid.Column="0" Margin="0,0,7.5,7.5" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="CPU 使用率历史 (60秒)"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>
                                        <lvc:CartesianChart Grid.Row="1"
                                                            x:Name="CpuChart"
                                                            LegendPosition="Hidden"/>
                                    </Grid>
                                </ui:Card>

                                <!-- Memory Chart -->
                                <ui:Card Grid.Row="0" Grid.Column="1" Margin="7.5,0,0,7.5" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="内存使用率历史 (60秒)"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>
                                        <lvc:CartesianChart Grid.Row="1"
                                                            x:Name="MemoryChart"
                                                            LegendPosition="Hidden"/>
                                    </Grid>
                                </ui:Card>

                                <!-- Disk Chart -->
                                <ui:Card Grid.Row="1" Grid.Column="0" Margin="0,7.5,7.5,0" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="磁盘活动 (MB/s)"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>
                                        <lvc:CartesianChart Grid.Row="1"
                                                            x:Name="DiskChart"
                                                            LegendPosition="Bottom"/>
                                    </Grid>
                                </ui:Card>

                                <!-- Network Chart -->
                                <ui:Card Grid.Row="1" Grid.Column="1" Margin="7.5,7.5,0,0" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="网络活动 (KB/s)"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>
                                        <lvc:CartesianChart Grid.Row="1"
                                                            x:Name="NetworkChart"
                                                            LegendPosition="Bottom"/>
                                    </Grid>
                                </ui:Card>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Hardware Info Tab -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,8,0"/>
                            <TextBlock Text="硬件信息" FontSize="14"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="15">
                            <StackPanel>
                                <TextBlock Text="硬件详细信息"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <!-- CPU Hardware Info -->
                                <TextBlock Text="处理器 (CPU)"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <ItemsControl x:Name="CpuHardwareItemsControl" Margin="0,0,0,20">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Card Margin="0,0,0,10" Padding="20">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <ui:SymbolIcon Grid.Column="0" Grid.RowSpan="4"
                                                                   Symbol="DatabaseStack24"
                                                                   FontSize="48"
                                                                   Margin="0,0,20,0"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                                                    <StackPanel Grid.Column="1" Grid.Row="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <Run Text="制造商:"/>
                                                            <Run Text="{Binding Manufacturer}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Grid Grid.Column="1" Grid.Row="1" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="核心/线程" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <Run Text="{Binding NumberOfCores}"/>
                                                                <Run Text="/"/>
                                                                <Run Text="{Binding NumberOfLogicalProcessors}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="最大频率" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <Run Text="{Binding MaxClockSpeed}"/>
                                                                <Run Text="MHz"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="架构" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding Architecture}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Grid.Column="1" Grid.Row="2" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="L2 缓存" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <Run Text="{Binding L2CacheSize}"/>
                                                                <Run Text="KB"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="L3 缓存" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <Run Text="{Binding L3CacheSize}"/>
                                                                <Run Text="KB"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="插槽" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding SocketDesignation}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Grid.Row="3" Margin="0,10,0,0">
                                                        <TextBlock Text="处理器 ID" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding ProcessorId}" FontSize="11" FontFamily="Consolas" Opacity="0.7"/>
                                                    </StackPanel>
                                                </Grid>
                                            </ui:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Memory Hardware Info -->
                                <TextBlock Text="内存 (RAM)"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,10"/>
                                <ItemsControl x:Name="MemoryHardwareItemsControl" Margin="0,0,0,20">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Card Margin="0,0,0,10" Padding="15">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ui:SymbolIcon Grid.Column="0" Symbol="BoxMultiple24" FontSize="32" Margin="0,0,15,0"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Manufacturer}" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding PartNumber}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="容量" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding CapacityFormatted}" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="速度" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock FontSize="13" FontWeight="SemiBold">
                                                            <Run Text="{Binding Speed}"/>
                                                            <Run Text="MHz"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="类型" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding MemoryType}" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="5">
                                                        <TextBlock Text="插槽" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding DeviceLocator}" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </ui:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Motherboard & BIOS Info -->
                                <Grid Margin="0,10,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="主板"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>
                                        <ui:Card x:Name="MotherboardCard" Padding="20">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Grid.Column="0" Symbol="Board24" FontSize="32" Margin="0,0,15,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="MotherboardManufacturer" Text="Unknown" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="MotherboardProduct" Text="Unknown" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Separator Margin="0,5,0,10"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="版本" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock x:Name="MotherboardVersion" Text="N/A" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="序列号" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock x:Name="MotherboardSerial" Text="N/A" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </ui:Card>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="BIOS"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,10"/>
                                        <ui:Card x:Name="BiosCard" Padding="20">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Grid.Column="0" Symbol="DocumentCode24" FontSize="32" Margin="0,0,15,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="BiosManufacturer" Text="Unknown" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="BiosName" Text="Unknown" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Separator Margin="0,5,0,10"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="版本" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock x:Name="BiosVersion" Text="N/A" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="发布日期" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock x:Name="BiosReleaseDate" Text="N/A" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </ui:Card>
                                    </StackPanel>
                                </Grid>

                                <!-- GPU Info -->
                                <TextBlock Text="显卡 (GPU)"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,10"/>
                                <ItemsControl x:Name="GpuItemsControl" Margin="0,0,0,20">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Card Margin="0,0,0,10" Padding="20">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <ui:SymbolIcon Grid.Column="0" Grid.RowSpan="3"
                                                                   Symbol="DesktopPulse24"
                                                                   FontSize="48"
                                                                   Margin="0,0,20,0"
                                                                   Foreground="#10893E"/>

                                                    <StackPanel Grid.Column="1" Grid.Row="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <Run Text="处理器:"/>
                                                            <Run Text="{Binding VideoProcessor}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Grid Grid.Column="1" Grid.Row="1" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="显存" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding AdapterRAMFormatted}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="分辨率" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <Run Text="{Binding CurrentHorizontalResolution}"/>
                                                                <Run Text="×"/>
                                                                <Run Text="{Binding CurrentVerticalResolution}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="刷新率" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                                                <Run Text="{Binding CurrentRefreshRate}"/>
                                                                <Run Text="Hz"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,10,0,0">
                                                        <TextBlock Text="驱动版本" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding DriverVersion}" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </ui:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Storage Devices -->
                                <TextBlock Text="存储设备"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,10"/>
                                <ItemsControl x:Name="StorageItemsControl" Margin="0,0,0,20">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Card Margin="0,0,0,10" Padding="20">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <ui:SymbolIcon Grid.Column="0" Grid.RowSpan="3"
                                                                   Symbol="HardDrive24"
                                                                   FontSize="48"
                                                                   Margin="0,0,20,0"
                                                                   Foreground="#FF8C00"/>

                                                    <StackPanel Grid.Column="1" Grid.Row="0">
                                                        <TextBlock Text="{Binding Model}" FontSize="16" FontWeight="Bold"/>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                            <Run Text="接口:"/>
                                                            <Run Text="{Binding InterfaceType}"/>
                                                            <Run Text=" | 类型:"/>
                                                            <Run Text="{Binding MediaType}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Grid Grid.Column="1" Grid.Row="1" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="容量" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding SizeFormatted}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="分区数" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding Partitions}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="固件版本" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding FirmwareRevision}" FontSize="14" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,10,0,0">
                                                        <TextBlock Text="序列号" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding SerialNumber}" FontSize="11" FontFamily="Consolas" Opacity="0.7"/>
                                                    </StackPanel>
                                                </Grid>
                                            </ui:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Network Adapters -->
                                <TextBlock Text="网络适配器"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,10"/>
                                <ItemsControl x:Name="NetworkItemsControl" Margin="0,0,0,20">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Card Margin="0,0,0,10" Padding="20">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ui:SymbolIcon Grid.Column="0" Symbol="Wifi124" FontSize="32" Margin="0,0,15,0"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Manufacturer}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="速度" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding SpeedFormatted}" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="类型" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding AdapterType}" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="MAC 地址" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding MACAddress}" FontSize="11" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Grid>
                                            </ui:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Operating System Info -->
                                <TextBlock Text="操作系统"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,10"/>
                                <ui:Card x:Name="OsCard" Padding="20" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ui:SymbolIcon Grid.Column="0" Grid.RowSpan="2"
                                                       Symbol="WindowDevTools24"
                                                       FontSize="48"
                                                       Margin="0,0,20,0"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                                        <StackPanel Grid.Column="1" Grid.Row="0">
                                            <TextBlock x:Name="OsName" Text="Unknown" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="制造商:"/>
                                                <Run x:Name="OsManufacturer" Text="Unknown"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Grid Grid.Column="1" Grid.Row="1" Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Column="0" Grid.Row="0">
                                                <TextBlock Text="版本" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock x:Name="OsVersion" Text="N/A" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Grid.Row="0">
                                                <TextBlock Text="内部版本" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock x:Name="OsBuildNumber" Text="N/A" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Grid.Row="0">
                                                <TextBlock Text="架构" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock x:Name="OsArchitecture" Text="N/A" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,10,0,0">
                                                <TextBlock Text="安装日期" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock x:Name="OsInstallDate" Text="N/A" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                <TextBlock Text="系统目录" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock x:Name="OsSystemDirectory" Text="N/A" FontSize="11" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </ui:Card>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Processes Tab -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Apps24" Margin="0,0,8,0"/>
                            <TextBlock Text="进程" FontSize="14"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="资源使用率最高的前 15 个进程"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <ui:Card Grid.Row="1" Padding="0">
                            <DataGrid x:Name="ProcessDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True"
                                      SelectionMode="Single"
                                      AlternatingRowBackground="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="进程 ID" Binding="{Binding ProcessId}" Width="100"/>
                                    <DataGridTextColumn Header="进程名称" Binding="{Binding ProcessName}" Width="*"/>
                                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuUsage, StringFormat=F2}" Width="120"/>
                                    <DataGridTextColumn Header="内存" Binding="{Binding MemoryUsageFormatted}" Width="120"/>
                                    <DataGridTextColumn Header="线程数" Binding="{Binding ThreadCount}" Width="100"/>
                                </DataGrid.Columns>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="结束进程" Click="EndProcess_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Dismiss24" Foreground="Red"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                        </ui:Card>
                    </Grid>
                </TabItem>

                <!-- Disks Tab -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="HardDrive24" Margin="0,0,8,0"/>
                            <TextBlock Text="磁盘" FontSize="14"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="磁盘分区使用情况"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DiskItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Margin="0,0,0,15" Padding="20">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ui:SymbolIcon Grid.Column="0" Symbol="HardDrive24" FontSize="32" Margin="0,0,15,0"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontSize="18" FontWeight="SemiBold">
                                                            <Run Text="{Binding VolumeLabel}"/>
                                                            <Run Text="(" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <Run Text="{Binding DriveName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <Run Text=")" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding DriveFormat}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <ProgressBar Grid.Row="1"
                                                             Height="20"
                                                             Value="{Binding UsagePercentage}"
                                                             Maximum="100"
                                                             Margin="0,0,0,10"/>

                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="总容量" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding TotalSizeFormatted}" FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="已使用" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding UsedSpaceFormatted}" FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="可用空间" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding FreeSpaceFormatted}" FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="使用率" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                                            <Run Text="{Binding UsagePercentage, StringFormat=F1}"/>
                                                            <Run Text="%"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Benchmark Tab -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TopSpeed24" Margin="0,0,8,0"/>
                            <TextBlock Text="性能测试" FontSize="14"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="性能跑分测试"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="全面测试 CPU、内存、磁盘性能，获取综合评分"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,20"/>

                                <!-- Control Buttons -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:Button Grid.Column="0"
                                              x:Name="StartBenchmarkButton"
                                              Content="开始测试"
                                              Icon="Play24"
                                              Appearance="Primary"
                                              Margin="0,0,10,0"
                                              Click="StartBenchmark_Click"/>

                                    <ui:Button Grid.Column="1"
                                              x:Name="StopBenchmarkButton"
                                              Content="停止测试"
                                              Icon="Stop24"
                                              IsEnabled="False"
                                              Click="StopBenchmark_Click"/>
                                </Grid>

                                <!-- Progress -->
                                <ui:Card Padding="20" Margin="0,0,0,20" x:Name="BenchmarkProgressCard" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BenchmarkCurrentTest"
                                                       Text="正在准备测试..."
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1"
                                                       x:Name="BenchmarkProgressPercent"
                                                       Text="0%"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </Grid>
                                        <ProgressBar x:Name="BenchmarkProgressBar"
                                                    Height="8"
                                                    Value="0"
                                                    Maximum="100"
                                                    Margin="0,0,0,10"/>
                                        <TextBlock x:Name="BenchmarkStatus"
                                                  Text="等待开始..."
                                                  FontSize="12"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>

                            <!-- Results -->
                            <StackPanel Grid.Row="1" x:Name="BenchmarkResultsPanel" Visibility="Collapsed">
                                <!-- Overall Score -->
                                <ui:Card Padding="30" Margin="0,0,0,20" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Grid.Column="0"
                                                      Symbol="Trophy24"
                                                      FontSize="64"
                                                      Margin="0,0,30,0"
                                                      x:Name="OverallScoreIcon"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="综合得分"
                                                      FontSize="16"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      Margin="0,0,0,5"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                          x:Name="OverallScoreText"
                                                          Text="0"
                                                          FontSize="48"
                                                          FontWeight="Bold"
                                                          Margin="0,0,15,0"/>
                                                <TextBlock Grid.Column="1"
                                                          x:Name="PerformanceRatingText"
                                                          Text="未测试"
                                                          FontSize="20"
                                                          FontWeight="SemiBold"
                                                          VerticalAlignment="Bottom"
                                                          Margin="0,0,0,8"/>
                                            </Grid>
                                            <TextBlock x:Name="BenchmarkDateText"
                                                      Text="测试时间: N/A"
                                                      FontSize="12"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>

                                <!-- Individual Scores -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- CPU Single Core -->
                                    <ui:Card Grid.Row="0" Grid.Column="0" Padding="20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="Chip24" FontSize="40" Margin="0,0,15,0" Foreground="#0078D4"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="CPU 单核" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock x:Name="CpuSingleCoreScoreText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#0078D4"/>
                                                <TextBlock x:Name="CpuSingleDurationText" Text="耗时: N/A" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>

                                    <!-- CPU Multi Core -->
                                    <ui:Card Grid.Row="0" Grid.Column="2" Padding="20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="DatabaseStack24" FontSize="40" Margin="0,0,15,0" Foreground="#10893E"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="CPU 多核" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock x:Name="CpuMultiCoreScoreText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#10893E"/>
                                                <TextBlock x:Name="CpuMultiDurationText" Text="耗时: N/A" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>

                                    <!-- Memory -->
                                    <ui:Card Grid.Row="2" Grid.Column="0" Padding="20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="BoxMultiple24" FontSize="40" Margin="0,0,15,0" Foreground="#8A2BE2"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="内存带宽" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock x:Name="MemoryScoreText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#8A2BE2"/>
                                                <TextBlock x:Name="MemoryDurationText" Text="耗时: N/A" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>

                                    <!-- Disk -->
                                    <ui:Card Grid.Row="2" Grid.Column="2" Padding="20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="HardDrive24" FontSize="40" Margin="0,0,15,0" Foreground="#FF8C00"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="磁盘读写" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="读: " FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock x:Name="DiskReadScoreText" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="#FF8C00"/>
                                                    <TextBlock Text=" / 写: " FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="5,0,0,0"/>
                                                    <TextBlock x:Name="DiskWriteScoreText" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="#FF8C00"/>
                                                </StackPanel>
                                                <TextBlock x:Name="DiskDurationText" Text="耗时: N/A" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </Grid>

                                <!-- Test Info -->
                                <ui:Card Padding="20" Margin="0,20,0,0">
                                    <StackPanel>
                                        <TextBlock Text="测试说明" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="• CPU 单核: 测试单线程性能，主要评估处理器单核心计算能力"/>
                                            <LineBreak/>
                                            <Run Text="• CPU 多核: 测试多线程性能，评估所有核心协同工作能力"/>
                                            <LineBreak/>
                                            <Run Text="• 内存带宽: 测试内存读写速度和带宽性能"/>
                                            <LineBreak/>
                                            <Run Text="• 磁盘读写: 测试系统盘的顺序读写性能"/>
                                            <LineBreak/><LineBreak/>
                                            <Run Text="综合得分计算方式: CPU单核 15% + CPU多核 25% + 内存 30% + 磁盘读 15% + 磁盘写 15%"/>
                                        </TextBlock>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Settings Tab -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,8,0"/>
                            <TextBlock Text="设置" FontSize="14"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="15">
                            <StackPanel MaxWidth="800">
                                <TextBlock Text="应用设置"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>

                                <!-- Theme Setting -->
                                <ui:Card Margin="0,0,0,15" Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="应用主题" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBlock Text="选择浅色或深色主题"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <ComboBox Grid.Column="1"
                                                  x:Name="ThemeComboBox"
                                                  Width="150"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="深色" Tag="Dark"/>
                                            <ComboBoxItem Content="浅色" Tag="Light"/>
                                        </ComboBox>
                                    </Grid>
                                </ui:Card>

                                <!-- Startup Setting -->
                                <ui:Card Margin="0,0,0,15" Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="最小化到系统托盘" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBlock Text="最小化时隐藏到系统托盘而不是任务栏"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <ui:ToggleSwitch Grid.Column="1"
                                                        x:Name="MinimizeToTrayToggle"
                                                        IsChecked="True"
                                                        VerticalAlignment="Center"/>
                                    </Grid>
                                </ui:Card>

                                <!-- Desktop Widget -->
                                <ui:Card Margin="0,0,0,15" Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="桌面悬浮小部件" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBlock Text="在桌面显示性能监控小部件"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <ui:ToggleSwitch Grid.Column="1"
                                                        x:Name="ShowWidgetToggle"
                                                        IsChecked="False"
                                                        VerticalAlignment="Center"
                                                        Checked="ShowWidgetToggle_Checked"
                                                        Unchecked="ShowWidgetToggle_Unchecked"/>
                                    </Grid>
                                </ui:Card>

                                <!-- Smart Tray Icon -->
                                <ui:Card Margin="0,0,0,15" Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="智能托盘图标" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <TextBlock Text="托盘图标动态显示 CPU 使用率"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <ui:ToggleSwitch Grid.Column="1"
                                                        x:Name="SmartTrayIconToggle"
                                                        IsChecked="True"
                                                        VerticalAlignment="Center"/>
                                    </Grid>
                                </ui:Card>

                                <!-- About -->
                                <ui:Card Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <TextBlock Text="Fluent Monitor v1.4" FontSize="14" Margin="0,0,0,5"/>
                                        <TextBlock Text="基于 Microsoft Fluent Design 的系统性能监测工具"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="© 2025 Fluent Monitor. MIT License"/>
                                        </TextBlock>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</ui:FluentWindow>
